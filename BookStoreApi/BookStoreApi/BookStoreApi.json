{
  "openapi": "3.1.1",
  "info": {
    "title": "Store for learn",
    "description": "Учебный проект для того, чтобы вспомнить старое, научиться новому и пробовать применять всякое",
    "termsOfService": "https://localhost",
    "contact": {
      "name": "Аноним",
      "url": "https://localhost",
      "email": "email@example.com"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "v1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5290",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/Cart/AddProduct": {
      "post": {
        "tags": [
          "Cart"
        ],
        "summary": "Добавить товар в корзину.",
        "parameters": [
          {
            "name": "productId",
            "in": "query",
            "description": "Идентификатор товара.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Товар добавлен в корзину."
          },
          "400": {
            "description": "Продукт не найден в БД.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Cart/GetCartItems": {
      "get": {
        "tags": [
          "Cart"
        ],
        "summary": "Получить все товары в корзине.",
        "responses": {
          "200": {
            "description": "Товары получены.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductAndNumberDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductAndNumberDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductAndNumberDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Images/GetImagesByProductIds": {
      "get": {
        "tags": [
          "Images"
        ],
        "summary": "Получить изображение по идентификаторам товаров.",
        "requestBody": {
          "description": "Идентификаторы товаров.",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
                  "type": [
                    "integer",
                    "string"
                  ],
                  "format": "int32"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
                  "type": [
                    "integer",
                    "string"
                  ],
                  "format": "int32"
                }
              }
            },
            "application/*+json": {
              "schema": {
                "type": "array",
                "items": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
                  "type": [
                    "integer",
                    "string"
                  ],
                  "format": "int32"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Картинки получены.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FileDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Login/Login": {
      "post": {
        "tags": [
          "Login"
        ],
        "summary": "Вход пользователя в систему.",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "Имя пользователя.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "password",
            "in": "query",
            "description": "Пароль.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешная аутентификация, выслан токен.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Неверное имя пользователя или пароль.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Login/Register": {
      "post": {
        "tags": [
          "Login"
        ],
        "summary": "Регистрация пользователя.",
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "Имя пользователя.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "password",
            "in": "query",
            "description": "Пароль.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешная регистрация."
          },
          "400": {
            "description": "Имя пользователя занято.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Orders/GetOrders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Получение заказов.",
        "responses": {
          "200": {
            "description": "Список заказов получен.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Orders/GetOrderById": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Получение заказов.",
        "parameters": [
          {
            "name": "orderId",
            "in": "query",
            "description": "Идентификатор заказа.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список заказов получен.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDto"
                }
              }
            }
          },
          "401": {
            "description": "Пользователь не авторизован.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Products/GetProducts": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Получить товары по фильтру.",
        "requestBody": {
          "description": "Фильтр.",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/FilterDto"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/FilterDto"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/FilterDto"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Товары получены.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductFullDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductFullDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductFullDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FileDto": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string",
            "description": "Гуид",
            "format": "uuid"
          },
          "bytes": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "uint8"
            },
            "description": "Байты"
          }
        },
        "description": "Dto файла"
      },
      "FilterDto": {
        "type": "object",
        "properties": {
          "productName": {
            "type": [
              "null",
              "string"
            ],
            "description": "Наименование товара"
          },
          "priceFrom": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Цена от",
            "format": "double"
          },
          "priceTo": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Цена до",
            "format": "double"
          },
          "onlyInStock": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Получать только товары в наличии"
          }
        },
        "description": "Dto фильтра"
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Jwt токен доступа"
          },
          "username": {
            "type": "string",
            "description": "Имя пользователя"
          }
        },
        "description": "Dto для ответа на вход в профиль."
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "orderStatus": {
            "description": "Статус заказа.",
            "$ref": "#/components/schemas/OrderStatusEnum"
          },
          "orderType": {
            "description": "Тип заказа.",
            "$ref": "#/components/schemas/OrderTypeEnum"
          },
          "orderDateTime": {
            "type": "string",
            "description": "Дата и время заказа.",
            "format": "date-time"
          },
          "totalPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Итоговая цена",
            "format": "double"
          },
          "productsAndNumbers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductAndNumberDto"
            },
            "description": "Коллекция пар \"Продукт-Количество\""
          }
        },
        "description": "Дто заказа"
      },
      "OrderStatusEnum": {
        "type": "integer",
        "description": "Статус заказа"
      },
      "OrderTypeEnum": {
        "type": "integer",
        "description": "Тип заказа"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProductAndNumberDto": {
        "type": "object",
        "properties": {
          "product": {
            "description": "Товар.",
            "$ref": "#/components/schemas/ProductFullDto"
          },
          "productNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Количество товара.",
            "format": "int32"
          }
        },
        "description": "Dto для отправки товара и его количества."
      },
      "ProductFullDto": {
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Идентификатор.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "Наименование."
          },
          "imageGuids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Гуиды картинок товара."
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Цена.",
            "format": "double"
          }
        },
        "description": "Dto товара со всей информацией."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Вставьте ваш JWT токен",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "Cart"
    },
    {
      "name": "Images"
    },
    {
      "name": "Login"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Products"
    }
  ]
}